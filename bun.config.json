{
  "name": "statosphera-redesign",
  "version": "1.0.0",
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:sales-dynamics": "bun test -- --testPathPattern=sales-dynamics-joyride",
    "test:sales-dynamics:watch": "bun test --watch -- --testPathPattern=sales-dynamics-joyride",
    "test:sales-dynamics:coverage": "bun test --coverage -- --testPathPattern=sales-dynamics-joyride"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/src/setupTests.ts"],
    "moduleNameMapping": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@shared/(.*)$": "<rootDir>/src/5_shared/$1",
      "^@entities/(.*)$": "<rootDir>/src/4_entities/$1",
      "^@features/(.*)$": "<rootDir>/src/3_features/$1",
      "^@widgets/(.*)$": "<rootDir>/src/2_widgets/$1",
      "^@pages/(.*)$": "<rootDir>/src/1_pages/$1",
      "^@app/(.*)$": "<rootDir>/src/0_app/$1"
    },
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest"
    },
    "testMatch": [
      "**/__tests__/**/*.(ts|tsx|js)",
      "**/*.(test|spec).(ts|tsx|js)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/*.spec.{ts,tsx}"
    ]
  }
}


